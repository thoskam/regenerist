    "data:check": "node scripts/check-data.cjs",
    "data:rules": "node scripts/build-rules.cjs"
  },
  "dependencies": {
    "@aws-sdk/client-bedrock-runtime": "^3.712.0",
    "@prisma/client": "5.22.0",
    "next": "15.5.25",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/node": "^20.17.6",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "autoprefixer": "^10.4.20",
    "eslint": "^8.57.1",
    "eslint-config-next": "^15.5.25",
    "postcss": "^8.5.23",
    "prisma": "5.22.0",
    "tailwindcss": "^3.4.15",
    "typescript": "^5.6.3"
  },
  "engines": {
    "node": ">=22"
  },
  "overrides": {
