generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Character {
  id           Int      @id @default(autoincrement())
  name         String
  slug         String   @unique
  level        Int      @default(1)
  isRegenerist Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  lives        Life[]
}

model Life {
  id                  Int       @id @default(autoincrement())
  lifeNumber          Int
  name                String
  race                String
  class               String
  subclass            String
  level               Int       @default(1)
  stats               Json      // {str, dex, con, int, wis, cha} - final stats with ASI applied
  baseStats           Json?     // {str, dex, con, int, wis, cha} - stats before ASI (standard array + racial)
  currentHp           Int
  maxHp               Int
  effect              String
  story               String    @db.Text
  skillProficiencies  String[]  @default([])
  subclassChoice      String?
  spellbook           Json?     // {spellNames: string[], archivistNote: string}
  gameplayState       Json?     // HP resources, death saves, spell slots, concentration
  createdAt           DateTime  @default(now())
  isActive            Boolean   @default(false)

  // Relationship to Character
  characterId         Int
  character           Character @relation(fields: [characterId], references: [id], onDelete: Cascade)

  // lifeNumber is unique per character, not globally
  @@unique([characterId, lifeNumber])
}

model Quirk {
  id          Int      @id @default(autoincrement())
  name        String
  description String   @db.Text
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

/// v2 character sheet. `doc` is a CharacterDoc (lib/sheet/types.ts); `state` is its PlayState.
model PlayerCharacter {
  id         String   @id @default(cuid())
  slug       String   @unique
  name       String
  doc        Json
  state      Json
  /// Increments on every write; clients send it back to detect stale edits.
  revision   Int      @default(0)
  avatar     Bytes?
  avatarType String?
  /// D&D Beyond character id, when imported.
  ddbId      String?  @unique
  /// The imported document as it was before conversion to a builder character (for undo).
  importBackup Json?
  /// Owning user (null in open single-user mode).
  ownerId    String?
  /// Party this character plays in.
  campaignId String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([ownerId])
  @@index([campaignId])
}

/// v2 accounts. When no users exist the app runs in open single-user mode.
model User {
  id           String   @id @default(cuid())
  username     String   @unique
  displayName  String
  passwordHash String
  isAdmin      Boolean  @default(false)
  createdAt    DateTime @default(now())
  /// Last request from a signed-in session (updated at most every few minutes).
  lastSeenAt   DateTime?
}

model Session {
  /// SHA-256 of the session token (the token itself only lives in the cookie).
  id        String   @id
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
}

model Campaign {
  id         String   @id @default(cuid())
  name       String
  inviteCode String   @unique
  dmUserId   String?
  createdAt  DateTime @default(now())
}

model CampaignMember {
  campaignId String
  userId     String
  role       String   @default("player")
  joinedAt   DateTime @default(now())

  @@id([campaignId, userId])
  @@index([userId])
}

model Roll {
  id            String   @id @default(cuid())
  campaignId    String
  characterSlug String?
  characterName String
  userId        String?
  label         String
  total         Int
  detail        String
  tag           String?
  createdAt     DateTime @default(now())

  @@index([campaignId, createdAt])
}
